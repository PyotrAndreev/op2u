{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://op2u.local/schemas/eusp_local_unexpectedness.schema.json",
  "title": "EUSP local-unexpectedness ranking experiment",
  "description": "A frozen synthetic ranking fixture. Locality and dates are explicit inputs only; no account, social, behavioural, inferred-location, or inferred-date data is representable.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_date", "supplied_windows", "frozen_inputs", "failure_conditions", "baseline", "treatment", "candidates"],
  "properties": {
    "schema_version": {"const": "eusp-local-unexpectedness/v1"},
    "snapshot_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "synthetic": {"type": "boolean"},
    "fixture_notice": {"type": "string", "minLength": 1},
    "supplied_windows": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/suppliedWindow"}},
    "frozen_inputs": {"$ref": "#/$defs/frozenInputs"},
    "failure_conditions": {"$ref": "#/$defs/failureConditions"},
    "baseline": {"$ref": "#/$defs/arm"},
    "treatment": {"$ref": "#/$defs/arm"},
    "candidates": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/candidate"}}
  },
  "$defs": {
    "suppliedWindow": {"type": "object", "additionalProperties": false, "required": ["id", "place", "start_date", "end_date", "provenance"], "properties": {
      "id": {"type": "string", "pattern": "^window-[a-z0-9][a-z0-9-]*$"},
      "place": {"type": "string", "minLength": 1},
      "start_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "end_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
      "provenance": {"const": "user_supplied"}
    }},
    "frozenInputs": {"type": "object", "additionalProperties": false, "required": ["candidate_set_sha256", "input_bundle_sha256", "research_budget", "report_budget_minutes", "selection_capacity"], "properties": {
      "candidate_set_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "input_bundle_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
      "research_budget": {"type": "object", "additionalProperties": false, "required": ["official_source_retrievals"], "properties": {"official_source_retrievals": {"type": "integer", "minimum": 0}}},
      "report_budget_minutes": {"type": "integer", "minimum": 1},
      "selection_capacity": {"type": "integer", "minimum": 1, "maximum": 7}
    }},
    "failureConditions": {"type": "object", "additionalProperties": false, "required": ["minimum_novelty_count_increase", "relevance_non_inferior", "require_full_grounding", "require_full_readiness", "require_evidence_liveness_and_act_now_safeguards"], "properties": {
      "minimum_novelty_count_increase": {"type": "integer", "minimum": 1},
      "relevance_non_inferior": {"const": true},
      "require_full_grounding": {"const": true},
      "require_full_readiness": {"const": true},
      "require_evidence_liveness_and_act_now_safeguards": {"const": true}
    }},
    "arm": {"type": "object", "additionalProperties": false, "required": ["id", "ranking_rule", "local_unexpectedness_bonus", "selection_capacity"], "properties": {
      "id": {"type": "string", "pattern": "^LU_[A-Z0-9_]+$"},
      "ranking_rule": {"enum": ["frozen_base_rank_descending", "frozen_base_rank_descending_plus_local_unexpectedness"]},
      "local_unexpectedness_bonus": {"type": "integer", "minimum": 0},
      "selection_capacity": {"type": "integer", "minimum": 1, "maximum": 7}
    }},
    "candidate": {"type": "object", "additionalProperties": false, "required": ["id", "base_rank", "relevance_proxy", "awareness", "locality", "classification", "first_action", "evidence"], "properties": {
      "id": {"type": "string", "pattern": "^lu-[a-z0-9][a-z0-9-]*$"},
      "base_rank": {"type": "integer", "minimum": 0},
      "relevance_proxy": {"type": "number", "minimum": 0, "maximum": 100},
      "awareness": {"type": "object", "additionalProperties": false, "required": ["state", "evidence"], "properties": {
        "state": {"enum": ["known", "unknown", "forgotten"]},
        "evidence": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["kind", "provenance", "statement"], "properties": {
          "kind": {"enum": ["explicit_current_recognition", "explicit_reminder_request"]},
          "provenance": {"const": "user_supplied_local"},
          "statement": {"type": "string", "minLength": 1}
        }}}
      }},
      "locality": {"type": "object", "additionalProperties": false, "required": ["place", "start_date", "end_date", "location_evidence_id", "date_evidence_id"], "properties": {
        "place": {"type": "string", "minLength": 1},
        "start_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "end_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
        "location_evidence_id": {"type": "string", "pattern": "^ev-[a-z0-9][a-z0-9-]*$"},
        "date_evidence_id": {"type": "string", "pattern": "^ev-[a-z0-9][a-z0-9-]*$"}
      }},
      "classification": {"enum": ["ACT_NOW", "PREPARE_NEXT"]},
      "first_action": {"type": "object", "additionalProperties": false, "required": ["action", "deliverable", "start_date", "minutes_min", "minutes_max", "blockers"], "properties": {
        "action": {"type": "string", "minLength": 1}, "deliverable": {"type": "string", "minLength": 1},
        "start_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "minutes_min": {"type": "integer", "minimum": 1, "maximum": 60}, "minutes_max": {"type": "integer", "minimum": 1, "maximum": 60},
        "blockers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      }},
      "evidence": {"type": "array", "minItems": 3, "items": {"$ref": "#/$defs/evidence"}}
    }},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["id", "claim", "quote", "url", "retrieved_at", "source_type", "entailment", "current_status", "temporal", "supports", "verification_artifact", "provenance_sha256"], "properties": {
      "id": {"type": "string", "pattern": "^ev-[a-z0-9][a-z0-9-]*$"}, "claim": {"type": "string", "minLength": 1}, "quote": {"type": "string", "minLength": 1}, "url": {"type": "string", "pattern": "^https://"}, "retrieved_at": {"type": "string", "minLength": 1},
      "source_type": {"const": "official_primary"}, "entailment": {"const": "direct"}, "current_status": {"enum": ["open", "upcoming", "rolling"]},
      "temporal": {"type": "object", "additionalProperties": false, "required": ["kind", "date", "start_date", "end_date"], "properties": {"kind": {"enum": ["deadline", "event", "rolling", null]}, "date": {"type": ["string", "null"]}, "start_date": {"type": ["string", "null"]}, "end_date": {"type": ["string", "null"]}}},
      "supports": {"type": "array", "minItems": 1, "items": {"enum": ["status", "participation_route", "liveness", "location", "date_window"]}},
      "verification_artifact": {"type": "string", "pattern": "^fixture://"}, "provenance_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
    }}
  }
}
