{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://op2u.local/schemas/eusp_known_forgotten.schema.json",
  "title": "EUSP local known-versus-forgotten ranking fixture",
  "description": "Explicit local awareness evidence and a synthetic ranking-evaluation oracle; never an account, history, social, or calendar record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_date", "candidates", "evaluation"],
  "properties": {
    "schema_version": {"const": "eusp-known-forgotten/v1"},
    "snapshot_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "synthetic": {"type": "boolean"},
    "fixture_notice": {"type": "string", "minLength": 1},
    "candidates": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classification", "action_priority", "gates", "awareness"],
        "properties": {
          "id": {"type": "string", "pattern": "^kf-[a-z0-9][a-z0-9-]*$"},
          "classification": {"enum": ["ACT_NOW", "PREPARE_NEXT"]},
          "action_priority": {"type": "integer", "minimum": 0},
          "gates": {
            "type": "object",
            "additionalProperties": false,
            "required": ["grounding", "liveness", "actionability"],
            "properties": {
              "grounding": {"enum": ["pass", "fail"]},
              "liveness": {"enum": ["pass", "fail"]},
              "actionability": {"enum": ["pass", "fail"]}
            }
          },
          "awareness": {
            "type": "object",
            "additionalProperties": false,
            "required": ["state", "evidence"],
            "properties": {
              "state": {"enum": ["known", "unknown", "forgotten"]},
              "evidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["kind", "provenance", "statement"],
                  "properties": {
                    "kind": {"enum": ["explicit_current_recognition", "explicit_reminder_request"]},
                    "provenance": {"const": "user_supplied_local"},
                    "statement": {"type": "string", "minLength": 1}
                  }
                }
              }
            }
          }
        }
      }
    },
    "evaluation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action_capacity", "high_value_priority_at_least", "reminder_useful_ids"],
      "properties": {
        "action_capacity": {"type": "integer", "minimum": 1, "maximum": 7},
        "high_value_priority_at_least": {"type": "integer", "minimum": 0},
        "reminder_useful_ids": {"type": "array", "items": {"type": "string", "pattern": "^kf-[a-z0-9][a-z0-9-]*$"}}
      }
    }
  }
}
