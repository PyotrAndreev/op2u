{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://op2u.local/schemas/production_output.schema.json",
  "title": "ProductionOpportunityPortfolio",
  "type": "object",
  "required": ["snapshot_date", "profile_state", "trigger_hypotheses", "candidates", "selected_ids", "weekly_allocation", "evidence_ledger", "rejected_candidates", "uncertainty_summary"],
  "properties": {
    "snapshot_date": {"type": "string"},
    "profile_state": {"type": "object"},
    "trigger_hypotheses": {"type": "array"},
    "candidates": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["candidate_id", "status", "claim_ids", "first_action", "scheduled_week_effort_minutes"],
        "properties": {
          "candidate_id": {"type": "string", "minLength": 1},
          "status": {"enum": ["ACT_NOW", "PREPARE_NEXT", "MONITOR", "REJECT"]},
          "claim_ids": {"type": "array", "items": {"type": "string"}},
          "first_action": {"type": "object"},
          "scheduled_week_effort_minutes": {
            "type": "object",
            "required": ["min", "max"],
            "properties": {"min": {"type": "integer", "minimum": 0}, "max": {"type": "integer", "minimum": 0}}
          }
        }
      }
    },
    "selected_ids": {
      "type": "object",
      "required": ["act_now", "prepare_next", "monitor"],
      "properties": {
        "act_now": {"type": "array", "maxItems": 3, "items": {"type": "string"}},
        "prepare_next": {"type": "array", "maxItems": 4, "items": {"type": "string"}},
        "monitor": {"type": "array", "items": {"type": "string"}}
      }
    },
    "weekly_allocation": {
      "type": "object",
      "required": ["cap_minutes", "scheduled_min_minutes", "scheduled_max_minutes", "residual_upper_minutes", "allocations"],
      "properties": {
        "cap_minutes": {"type": "integer", "minimum": 1, "maximum": 10080},
        "scheduled_min_minutes": {"type": "integer", "minimum": 0},
        "scheduled_max_minutes": {"type": "integer", "minimum": 0, "maximum": 10080},
        "residual_upper_minutes": {"type": "integer", "minimum": 0},
        "allocations": {"type": "array"}
      }
    },
    "evidence_ledger": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["ledger_id", "claim_id", "candidate_id", "claim", "quote", "url", "retrieved_at", "verification_artifact", "verification_artifact_hash", "entailment", "supports"],
        "properties": {
          "ledger_id": {"type": "string", "minLength": 1},
          "claim_id": {"type": "string", "minLength": 1},
          "candidate_id": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "retrieved_at": {"type": "string", "minLength": 1},
          "verification_artifact_hash": {"type": "string", "minLength": 64},
          "entailment": {"const": "direct"},
          "supports": {"type": "array", "minItems": 1}
        }
      }
    },
    "rejected_candidates": {"type": "array"},
    "uncertainty_summary": {"type": "array"}
  }
}
