{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://op2u.local/schemas/candidate.schema.json",
  "title": "OpportunityCandidate",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "title", "organization", "type", "classification", "official_url", "checked_at", "live_status", "evidence", "bridge", "first_action", "uncertainties"],
  "properties": {
    "id": {"type": "string", "minLength": 1},
    "title": {"type": "string", "minLength": 1},
    "organization": {"type": "string", "minLength": 1},
    "type": {"enum": ["grant", "fellowship", "cfp", "community", "research_collaboration", "residency", "accelerator", "travel_support", "other"]},
    "classification": {"enum": ["ACT_NOW", "PREPARE_NEXT", "MONITOR", "EXCLUDE"]},
    "official_url": {"type": "string", "format": "uri"},
    "checked_at": {"type": "string", "format": "date-time"},
    "live_status": {"enum": ["open", "upcoming", "rolling", "uncertain", "closed"]},
    "deadline": {"type": ["string", "null"]},
    "eligibility": {"type": ["string", "null"]},
    "funding_or_compensation": {"type": ["string", "null"]},
    "location": {"type": ["string", "null"]},
    "required_materials": {"type": "array", "items": {"type": "string"}},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["claim", "quote", "url", "retrieved_at", "source_type"],
        "properties": {
          "claim": {"type": "string"},
          "quote": {"type": "string"},
          "url": {"type": "string", "format": "uri"},
          "retrieved_at": {"type": "string", "format": "date-time"},
          "source_type": {"enum": ["official", "secondary"]}
        }
      }
    },
    "bridge": {"type": "array", "minItems": 1, "items": {"type": "string"}},
    "signals_connected": {"type": "array", "items": {"type": "string"}},
    "reusable_assets": {"type": "array", "items": {"type": "string"}},
    "first_action": {
      "type": "object",
      "additionalProperties": false,
      "required": ["action", "deliverable", "estimated_minutes", "within_seven_days"],
      "properties": {
        "action": {"type": "string"},
        "deliverable": {"type": "string"},
        "estimated_minutes": {"type": "integer", "minimum": 1},
        "within_seven_days": {"type": "boolean"}
      }
    },
    "total_effort_hours": {"type": ["number", "null"], "minimum": 0},
    "blockers": {"type": "array", "items": {"type": "string"}},
    "fallback": {"type": ["string", "null"]},
    "internal_deadline": {"type": ["string", "null"]},
    "uncertainties": {"type": "array", "items": {"type": "string"}},
    "scores": {"type": "object", "additionalProperties": {"type": "number"}}
  }
}
