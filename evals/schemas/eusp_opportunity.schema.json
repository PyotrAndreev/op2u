{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://op2u.local/schemas/eusp_opportunity.schema.json",
  "title": "EUSP opportunity",
  "description": "One opportunity with independently grounded value hypotheses and one owned path.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "title",
    "organization",
    "classification",
    "snapshot_date",
    "timezone",
    "eligibility_assessment",
    "evidence",
    "uncertainties",
    "value_hypotheses",
    "path"
  ],
  "properties": {
    "schema_version": {"const": "eusp-opportunity/v1"},
    "id": {"type": "string", "pattern": "^opp-[a-z0-9][a-z0-9-]*$"},
    "title": {"type": "string", "minLength": 1},
    "organization": {"type": "string", "minLength": 1},
    "classification": {"enum": ["ACT_NOW", "PREPARE_NEXT", "MONITOR", "REJECT"]},
    "snapshot_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "timezone": {"type": "string", "minLength": 1},
    "eligibility_assessment": {"const": "not_assessed"},
    "synthetic": {"type": "boolean"},
    "fixture_notice": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "quote", "url", "retrieved_at", "source_type", "entailment", "current_status", "temporal", "verification_artifact", "verification_artifact_sha256", "supports"],
        "properties": {
          "id": {"type": "string", "pattern": "^e-[a-z0-9][a-z0-9-]*$"},
          "claim": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "retrieved_at": {"type": "string", "minLength": 1},
          "source_type": {"const": "official_primary"},
          "entailment": {"const": "direct"},
          "current_status": {"enum": ["open", "upcoming", "rolling", "closed", "uncertain"]},
          "temporal": {
            "type": "object",
            "additionalProperties": false,
            "required": ["kind", "date", "start_date", "end_date"],
            "properties": {
              "kind": {"enum": ["deadline", "event", "rolling", "unknown"]},
              "date": {"type": ["string", "null"]},
              "start_date": {"type": ["string", "null"]},
              "end_date": {"type": ["string", "null"]}
            }
          },
          "verification_artifact": {"type": "string", "minLength": 1},
          "verification_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
          "supports": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    },
    "uncertainties": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "description"],
        "properties": {
          "id": {"type": "string", "pattern": "^u-[a-z0-9][a-z0-9-]*$"},
          "description": {"type": "string", "minLength": 1}
        }
      }
    },
    "value_hypotheses": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "statement", "causal_bridge", "profile_basis", "evidence_ids", "uncertainty_ids", "confidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^vh-[a-z0-9][a-z0-9-]*$"},
          "statement": {"type": "string", "minLength": 1},
          "causal_bridge": {"type": "string", "minLength": 1},
          "profile_basis": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["field_id", "provenance"], "properties": {"field_id": {"type": "string", "minLength": 1}, "provenance": {"const": "user_supplied"}}}},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^e-[a-z0-9][a-z0-9-]*$"}},
          "uncertainty_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^u-[a-z0-9][a-z0-9-]*$"}},
          "confidence": {"enum": ["low", "medium", "high"]}
        }
      }
    },
    "path": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "route_status", "verified_actions", "gaps", "components", "funding_packet", "path_cost"],
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "route_status": {"enum": ["verified_actions", "high_value_with_gaps", "exploration_lead"]},
        "verified_actions": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "action", "deliverable", "start_date", "minutes_min", "minutes_max", "evidence_ids"],
            "properties": {
              "id": {"type": "string", "pattern": "^a-[a-z0-9][a-z0-9-]*$"},
              "action": {"type": "string", "minLength": 1},
              "deliverable": {"type": "string", "minLength": 1},
              "start_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
              "minutes_min": {"type": "integer", "minimum": 1},
              "minutes_max": {"type": "integer", "minimum": 1, "maximum": 60},
              "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^e-[a-z0-9][a-z0-9-]*$"}}
            }
          }
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "question"],
            "properties": {
              "id": {"type": "string", "pattern": "^g-[a-z0-9][a-z0-9-]*$"},
              "question": {"type": "string", "minLength": 1}
            }
          }
        },
        "funding_packet": {
          "type": "object",
          "additionalProperties": false,
          "required": ["official_facts", "indirect_indicators", "gaps"],
          "properties": {
            "official_facts": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "claim", "evidence_ids"],
                "properties": {
                  "id": {"type": "string", "pattern": "^ff-[a-z0-9][a-z0-9-]*$"},
                  "kind": {"enum": ["programme", "deadline", "requirements", "documents"]},
                  "claim": {"type": "string", "minLength": 1},
                  "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^e-[a-z0-9][a-z0-9-]*$"}}
                }
              }
            },
            "indirect_indicators": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "kind", "claim", "quote", "source", "uncertainty"],
                "properties": {
                  "id": {"type": "string", "pattern": "^ci-[a-z0-9][a-z0-9-]*$"},
                  "kind": {"enum": ["pool_size", "acceptance_rate", "prior_recipients"]},
                  "claim": {"type": "string", "minLength": 1},
                  "quote": {"type": "string", "minLength": 1},
                  "source": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["url", "retrieved_at", "source_type", "verification_artifact", "verification_artifact_sha256"],
                    "properties": {
                      "url": {"type": "string", "pattern": "^https://"},
                      "retrieved_at": {"type": "string", "minLength": 1},
                      "source_type": {"enum": ["official_primary", "official_secondary", "independent_secondary"]},
                      "verification_artifact": {"type": "string", "minLength": 1},
                      "verification_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                    }
                  },
                  "uncertainty": {"type": "string", "minLength": 1}
                }
              }
            },
            "gaps": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["id", "subject", "question", "searched_sources"],
                "properties": {
                  "id": {"type": "string", "pattern": "^fg-[a-z0-9][a-z0-9-]*$"},
                  "subject": {"enum": ["programme", "deadline", "requirements", "documents", "pool_size", "acceptance_rate", "prior_recipients"]},
                  "question": {"type": "string", "minLength": 1},
                  "searched_sources": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "object",
                      "additionalProperties": false,
                      "required": ["url", "retrieved_at", "source_type", "verification_artifact", "verification_artifact_sha256"],
                      "properties": {
                        "url": {"type": "string", "pattern": "^https://"},
                        "retrieved_at": {"type": "string", "minLength": 1},
                        "source_type": {"enum": ["official_primary", "official_secondary", "independent_secondary"]},
                        "verification_artifact": {"type": "string", "minLength": 1},
                        "verification_artifact_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
                      }
                    }
                  }
                }
              }
            }
          }
        },
        "components": {
          "type": "array",
          "minItems": 5,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["component", "applicability", "status", "source_links", "retrieved_at", "assumptions", "evidence_ids", "gap_reason", "searched_sources"],
            "properties": {
              "component": {"enum": ["travel", "lodging", "visa", "funding", "outreach_route"]},
              "applicability": {"enum": ["applicable", "unknown", "not_applicable"]},
              "status": {"enum": ["verified", "gap", "not_applicable"]},
              "source_links": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}},
              "retrieved_at": {"type": "string", "minLength": 1},
              "assumptions": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
              "evidence_ids": {"type": "array", "items": {"type": "string", "pattern": "^e-[a-z0-9][a-z0-9-]*$"}},
              "gap_reason": {"type": ["string", "null"]},
              "searched_sources": {"type": "array", "items": {"type": "string", "pattern": "^https://"}}
            }
          }
        },
        "path_cost": {
          "type": "object",
          "additionalProperties": false,
          "required": ["date_basis", "programme_duration_days", "money", "time", "stress"],
          "properties": {
            "date_basis": {
              "type": "object",
              "additionalProperties": false,
              "required": ["kind", "selected_date", "opportunity_date", "evidence_id", "profile_field_id", "profile_provenance"],
              "properties": {
                "kind": {"enum": ["opportunity_date", "nearest_user_available_date"]},
                "selected_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                "opportunity_date": {"type": ["string", "null"], "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
                "evidence_id": {"type": ["string", "null"], "pattern": "^e-[a-z0-9][a-z0-9-]*$"},
                "profile_field_id": {"type": ["string", "null"], "pattern": "^geo-[1-9][0-9]*\\.period$"},
                "profile_provenance": {"type": ["string", "null"], "enum": ["user_supplied", null]}
              }
            },
            "programme_duration_days": {
              "type": ["object", "null"],
              "additionalProperties": false,
              "required": ["range", "location_basis", "retrieved_at", "source_provenance"],
              "properties": {
                "range": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": {"minimum": {"type": "integer", "minimum": 1}, "maximum": {"type": "integer", "minimum": 1}}},
                "location_basis": {"type": "string", "minLength": 1},
                "retrieved_at": {"type": "string", "minLength": 1},
                "source_provenance": {"type": "object", "additionalProperties": false, "required": ["source_type", "url", "quote"], "properties": {"source_type": {"enum": ["official_primary", "provider", "public_dataset"]}, "url": {"type": "string", "pattern": "^https://"}, "quote": {"type": "string", "minLength": 1}}}
              }
            },
            "money": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "estimates", "gaps"],
              "properties": {
                "status": {"enum": ["known", "partial", "unknown"]},
                "estimates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["category", "range", "currency", "research_priority", "location_basis", "retrieved_at", "source_provenance"], "properties": {"category": {"enum": ["programme_fee", "flights", "ground_transport", "lodging", "cost_of_living", "visa", "other"]}, "range": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum"], "properties": {"minimum": {"type": "number", "minimum": 0}, "maximum": {"type": "number", "minimum": 0}}}, "currency": {"type": "string", "pattern": "^[A-Z]{3}$"}, "research_priority": {"enum": ["primary", "secondary"]}, "location_basis": {"type": "string", "minLength": 1}, "retrieved_at": {"type": "string", "minLength": 1}, "source_provenance": {"type": "object", "additionalProperties": false, "required": ["source_type", "url", "quote"], "properties": {"source_type": {"enum": ["official_primary", "provider", "public_dataset"]}, "url": {"type": "string", "pattern": "^https://"}, "quote": {"type": "string", "minLength": 1}}}}}},
                "gaps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["category", "reason", "searched_sources"], "properties": {"category": {"enum": ["programme_fee", "flights", "ground_transport", "lodging", "cost_of_living", "visa", "other"]}, "reason": {"type": "string", "minLength": 1}, "searched_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}}}}}
              }
            },
            "time": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "estimates", "gaps"],
              "properties": {
                "status": {"enum": ["known", "partial", "unknown"]},
                "estimates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["category", "range", "location_basis", "retrieved_at", "source_provenance"], "properties": {"category": {"enum": ["travel", "local_transit", "programme_time", "preparation", "other"]}, "range": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "unit"], "properties": {"minimum": {"type": "integer", "minimum": 0}, "maximum": {"type": "integer", "minimum": 0}, "unit": {"const": "minutes"}}}, "location_basis": {"type": "string", "minLength": 1}, "retrieved_at": {"type": "string", "minLength": 1}, "source_provenance": {"type": "object", "additionalProperties": false, "required": ["source_type", "url", "quote"], "properties": {"source_type": {"enum": ["official_primary", "provider", "public_dataset"]}, "url": {"type": "string", "pattern": "^https://"}, "quote": {"type": "string", "minLength": 1}}}}}},
                "gaps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["reason", "searched_sources"], "properties": {"reason": {"type": "string", "minLength": 1}, "searched_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}}}}}
              }
            },
            "stress": {
              "type": "object",
              "additionalProperties": false,
              "required": ["status", "estimates", "gaps"],
              "properties": {
                "status": {"enum": ["known", "partial", "unknown"]},
                "estimates": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["category", "range", "location_basis", "retrieved_at", "source_provenance"], "properties": {"category": {"enum": ["travel", "schedule", "administrative", "other"]}, "range": {"type": "object", "additionalProperties": false, "required": ["minimum", "maximum", "scale"], "properties": {"minimum": {"type": "integer", "minimum": 1, "maximum": 5}, "maximum": {"type": "integer", "minimum": 1, "maximum": 5}, "scale": {"const": "stress_1_to_5"}}}, "location_basis": {"type": "string", "minLength": 1}, "retrieved_at": {"type": "string", "minLength": 1}, "source_provenance": {"type": "object", "additionalProperties": false, "required": ["source_type", "url", "quote"], "properties": {"source_type": {"enum": ["official_primary", "provider", "public_dataset"]}, "url": {"type": "string", "pattern": "^https://"}, "quote": {"type": "string", "minLength": 1}}}}}},
                "gaps": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["reason", "searched_sources"], "properties": {"reason": {"type": "string", "minLength": 1}, "searched_sources": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^https://"}}}}}
              }
            }
          }
        }
      }
    }
  }
}
