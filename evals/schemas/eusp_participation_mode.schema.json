{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://op2u.local/schemas/eusp_participation_mode.schema.json",
  "title": "EUSP non-obvious participation-mode ranking fixture",
  "description": "A frozen synthetic comparison of one mode-ranking signal; never an account, social, behavioural, or eligibility record.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_date", "candidates", "controls", "failure_condition"],
  "properties": {
    "schema_version": {"const": "eusp-participation-mode/v1"},
    "synthetic": {"type": "boolean"},
    "fixture_notice": {"type": "string", "minLength": 1},
    "snapshot_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "candidates": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "classification", "baseline_priority", "relevance_proxy", "readiness_score", "minutes_max", "gates", "participation_mode", "readiness_checks", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^pm-[a-z0-9][a-z0-9-]*$"},
          "classification": {"enum": ["ACT_NOW", "PREPARE_NEXT"]},
          "baseline_priority": {"type": "integer", "minimum": 0},
          "relevance_proxy": {"type": "number", "minimum": 0, "maximum": 100},
          "readiness_score": {"type": "number", "minimum": 0, "maximum": 100},
          "minutes_max": {"type": "integer", "minimum": 1, "maximum": 60},
          "gates": {
            "type": "object", "additionalProperties": false,
            "required": ["grounding", "liveness", "actionability"],
            "properties": {"grounding": {"enum": ["pass", "fail"]}, "liveness": {"enum": ["pass", "fail"]}, "actionability": {"enum": ["pass", "fail"]}}
          },
          "participation_mode": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "non_obvious"],
            "properties": {"id": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"}, "non_obvious": {"type": "boolean"}}
          },
          "readiness_checks": {
            "type": "object", "additionalProperties": false,
            "required": ["profile_bridge", "local_deliverable", "seven_day_start", "bounded_effort", "blockers_disclosed"],
            "properties": {"profile_bridge": {"type": "boolean"}, "local_deliverable": {"type": "boolean"}, "seven_day_start": {"type": "boolean"}, "bounded_effort": {"type": "boolean"}, "blockers_disclosed": {"type": "boolean"}}
          },
          "evidence": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["claim", "quote", "url", "retrieved_at", "source_type", "current_status", "temporal", "supports"],
              "properties": {
                "claim": {"type": "string", "minLength": 1}, "quote": {"type": "string", "minLength": 1},
                "url": {"type": "string", "pattern": "^https://"}, "retrieved_at": {"type": "string", "minLength": 1},
                "source_type": {"const": "direct_official_primary"}, "current_status": {"enum": ["open", "upcoming", "rolling", "closed", "unknown"]},
                "temporal": {"type": "object", "additionalProperties": false, "required": ["kind"], "properties": {"kind": {"enum": ["deadline", "event", "rolling"]}, "date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}, "end_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"}}},
                "supports": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
              }
            }
          }
        }
      }
    },
    "controls": {
      "type": "object", "additionalProperties": false, "required": ["baseline", "intervention"],
      "properties": {
        "baseline": {"type": "object", "additionalProperties": false, "required": ["frozen_input_id", "frozen_input_sha256", "source_research_budget", "report_budget", "action_capacity", "weekly_minutes_cap"], "properties": {"frozen_input_id": {"type": "string", "minLength": 1}, "frozen_input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "source_research_budget": {"type": "object", "additionalProperties": false, "required": ["max_primary_source_records"], "properties": {"max_primary_source_records": {"type": "integer", "minimum": 1}}}, "report_budget": {"type": "object", "additionalProperties": false, "required": ["max_candidates_rendered"], "properties": {"max_candidates_rendered": {"type": "integer", "minimum": 1}}}, "action_capacity": {"type": "integer", "minimum": 1, "maximum": 7}, "weekly_minutes_cap": {"type": "integer", "minimum": 1}}},
        "intervention": {"type": "object", "additionalProperties": false, "required": ["frozen_input_id", "frozen_input_sha256", "source_research_budget", "report_budget", "action_capacity", "weekly_minutes_cap", "non_obvious_mode_bonus"], "properties": {"frozen_input_id": {"type": "string", "minLength": 1}, "frozen_input_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}, "source_research_budget": {"type": "object", "additionalProperties": false, "required": ["max_primary_source_records"], "properties": {"max_primary_source_records": {"type": "integer", "minimum": 1}}}, "report_budget": {"type": "object", "additionalProperties": false, "required": ["max_candidates_rendered"], "properties": {"max_candidates_rendered": {"type": "integer", "minimum": 1}}}, "action_capacity": {"type": "integer", "minimum": 1, "maximum": 7}, "weekly_minutes_cap": {"type": "integer", "minimum": 1}, "non_obvious_mode_bonus": {"type": "integer", "minimum": 1}}}
      }
    },
    "failure_condition": {
      "type": "object", "additionalProperties": false,
      "required": ["minimum_mode_novelty_delta", "minimum_relevance_delta", "minimum_readiness_delta", "minimum_grounding_rate"],
      "properties": {"minimum_mode_novelty_delta": {"type": "number", "minimum": 0}, "minimum_relevance_delta": {"type": "number"}, "minimum_readiness_delta": {"type": "number"}, "minimum_grounding_rate": {"type": "number", "minimum": 0, "maximum": 1}}
    }
  }
}
