{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://op2u.local/schemas/eusp_action.schema.json",
  "title": "EUSP local action portfolio",
  "description": "Local, artifact-producing next actions; never an execution request.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "snapshot_date", "timezone", "evidence", "actions"],
  "properties": {
    "schema_version": {"const": "eusp-action/v1"},
    "snapshot_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
    "timezone": {"type": "string", "minLength": 1},
    "synthetic": {"type": "boolean"},
    "fixture_notice": {"type": "string", "minLength": 1},
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "claim", "quote", "url", "retrieved_at", "source_type", "entailment", "supports", "purpose"],
        "properties": {
          "id": {"type": "string", "pattern": "^e-[a-z0-9][a-z0-9-]*$"},
          "claim": {"type": "string", "minLength": 1},
          "quote": {"type": "string", "minLength": 1},
          "url": {"type": "string", "pattern": "^https://"},
          "retrieved_at": {"type": "string", "minLength": 1},
          "source_type": {"const": "official_primary"},
          "entailment": {"const": "direct"},
          "supports": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^a-[a-z0-9][a-z0-9-]*$"}},
          "purpose": {"enum": ["action_basis", "verified_shared_context"]}
        }
      }
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "classification", "kind", "action", "deliverable", "start_date", "minutes_min", "minutes_max", "blockers", "evidence_ids"],
        "properties": {
          "id": {"type": "string", "pattern": "^a-[a-z0-9][a-z0-9-]*$"},
          "classification": {"enum": ["ACT_NOW", "PREPARE_NEXT"]},
          "kind": {"enum": ["local_artifact", "cold_outreach_draft"]},
          "action": {"type": "string", "minLength": 1},
          "deliverable": {"type": "string", "minLength": 1},
          "start_date": {"type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$"},
          "minutes_min": {"type": "integer", "minimum": 1},
          "minutes_max": {"type": "integer", "minimum": 1, "maximum": 60},
          "blockers": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^e-[a-z0-9][a-z0-9-]*$"}},
          "draft": {
            "type": "object",
            "additionalProperties": false,
            "required": ["text", "shared_context"],
            "properties": {
              "text": {"type": "string", "minLength": 1},
              "shared_context": {
                "type": "object",
                "additionalProperties": false,
                "required": ["profile_field_id", "provenance", "evidence_ids"],
                "properties": {
                  "profile_field_id": {"type": "string", "pattern": "^(?:geo-[1-9][0-9]*\\.(?:place|period)|career_ambition-[1-9][0-9]*|thematic_interest-[1-9][0-9]*|(?:goal|outcome)-[1-9][0-9]*|asset-[1-9][0-9]*|constraint-[1-9][0-9]*|preference-[1-9][0-9]*|unknown-[1-9][0-9]*)$"},
                  "provenance": {"const": "user_supplied"},
                  "evidence_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^e-[a-z0-9][a-z0-9-]*$"}}
                }
              }
            }
          }
        }
      }
    }
  }
}
